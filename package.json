{
  "name": "trove-release-reminder",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/check-releases.mjs",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit --pretty false",
    "preview": "vite preview",
    "data:pull": "node scripts/pull-releases.mjs",
    "data:push": "node scripts/push-releases.mjs",
    "data:push:install": "node scripts/macos/data-push-agent.mjs install",
    "data:push:uninstall": "node scripts/macos/data-push-agent.mjs uninstall",
    "data:push:status": "node scripts/macos/data-push-agent.mjs status",
    "test": "node --test \"scripts/test/*.test.mjs\"",
    "test:db": "node --test \"supabase/tests/*.test.mjs\"",
    "smoke": "node scripts/smoke/smoke.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.3",
    "vite": "^6.0.11"
  }
}
